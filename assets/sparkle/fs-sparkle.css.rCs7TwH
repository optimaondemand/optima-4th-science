--- assets/sparkle/fs-sparkle.css
+++ assets/sparkle/fs-sparkle.css
@@ -1684,3 +1684,103 @@ html:not(.fs-on) .fs-name-note{display:none!important;}
 @media (prefers-reduced-motion: reduce) { .fs-gp-cart { transition:none; } }
 .fs-gp-photo img { width:100%; max-height:240px; object-fit:cover; border-radius:12px; display:block; margin:4px 0 10px; }
 @media (max-width:640px) { .fs-sc-r { grid-template-columns: 1fr 1fr; } .fs-sc-t { grid-column: 1 / -1; } .fs-sc-head span, .fs-sc-tot span { grid-column: 1 / -1; } .fs-sc-head span:empty { display:none; } }
+
+/* ===== 14.01: dip-net jars case, What comes next?, Side by side, Close the circle, Alike and different, dip net ===== */
+.fs-case-jars .fs-logs { grid-template-columns: repeat(3, 1fr); gap:16px; }
+.fs-case-jars .fs-log { background:linear-gradient(180deg, #F4FBFC 0%, #E2F1F3 100%); border:3px solid #A9CDD3; border-radius:14px 14px 28px 28px; padding:22px 10px 12px; font:700 12.5px/1.35 'Segoe Print','Bradley Hand','Comic Sans MS',cursive; color:#2E3B3E; position:relative; }
+.fs-case-jars .fs-log::before { content:''; position:absolute; top:-10px; left:10%; right:10%; height:14px; border-radius:5px; background:linear-gradient(180deg,#5D6F74,#3E4C50); box-shadow:0 2px 0 rgba(0,0,0,.15); }
+.fs-case-jars .fs-log:nth-child(1) { transform: rotate(-1.5deg); } .fs-case-jars .fs-log:nth-child(2) { transform: rotate(1deg); } .fs-case-jars .fs-log:nth-child(3) { transform: rotate(-.6deg); }
+.fs-case-jars .fs-log-img { margin:0 0 8px; height:130px; border-radius:10px 10px 18px 18px; border:2px solid rgba(255,255,255,.8); }
+.fs-case-jars .fs-log-h { background:#FFFDF4; border:1px solid #D9CFAE; border-radius:3px; padding:2px 6px; display:inline-block; color:#5A4318; }
+.fs-case-jars .fs-log dt { color:#5E7A80; }
+.fs-case-jars .fs-log-big { font-size:24px; }
+.fs-case-jars .fs-log-sticky { bottom:-30px; }
+.fs-nu-strip { display:flex; align-items:center; flex-wrap:wrap; gap:6px; min-height:40px; margin:6px 0 10px; padding:8px; background:#F7FBFC; border:1.5px dashed #B9CCD1; border-radius:12px; }
+.fs-nu-card { width:96px; text-align:center; font:900 12.5px 'Nunito',sans-serif; color:#0E1C42; }
+.fs-nu-card img { width:100%; aspect-ratio:1/1; object-fit:cover; border-radius:8px; border:2px solid #fff; box-shadow:0 1px 4px rgba(0,0,0,.2); display:block; margin-bottom:2px; }
+.fs-nu-card.pop { animation: fsPop .45s; }
+.fs-nu-arr { font-style:normal; font-size:20px; color:#2E9E5E; } .fs-nu-arr.big { font-size:30px; align-self:center; } .fs-nu-arr.back { color:#B9822A; }
+.fs-nu-loop { font:900 13px 'Nunito',sans-serif; color:#8A5A12; background:#FFF6DD; border:1.5px solid #E8C877; border-radius:999px; padding:4px 10px; }
+.fs-nu-stage { display:flex; flex-wrap:wrap; gap:12px; align-items:flex-start; }
+.fs-nu-lab { font:900 12px 'Nunito',sans-serif; text-transform:uppercase; letter-spacing:.6px; color:#5A6B72; margin-bottom:4px; }
+.fs-nu-now .fs-nu-card { width:130px; }
+.fs-nu-slot { width:130px; border:3px dashed #9FB7BE; border-radius:12px; background:#F7FBFC; text-align:center; padding:6px; cursor:pointer; transition: border-color .2s, background .2s; }
+.fs-nu-slot.over { border-color: var(--fs-gold); background:#FFF9E8; }
+.fs-nu-q { font:900 54px/120px 'Nunito',sans-serif; color:#B9CCD1; }
+.fs-nu-pick { flex:1 1 260px; display:flex; flex-wrap:wrap; gap:8px; } .fs-nu-pick .fs-nu-lab { width:100%; }
+.fs-nu-ch { width:110px; display:flex; flex-direction:column; align-items:center; gap:3px; padding:5px; text-align:center; touch-action:none; cursor:grab; }
+.fs-nu-ch img { width:100%; aspect-ratio:1/1; object-fit:cover; border-radius:7px; pointer-events:none; } .fs-nu-ch span { font-size:13px; }
+.fs-nu-ch.ghost, .fs-wh-card.ghost, .fs-vn-card.ghost { position:fixed; z-index:9999; pointer-events:none; opacity:.92; }
+.fs-mo-ctl { background:#F7FBFC; border:1.5px solid #D2E1E5; border-radius:12px; padding:10px 14px; margin:8px 0; }
+.fs-mo-lab { font:800 15px 'Nunito',sans-serif; color:#0E1C42; }
+.fs-mo-range { width:100%; accent-color:#2E9E5E; height:28px; }
+.fs-mo-ticks { display:flex; justify-content:space-between; font:800 12px 'Nunito',sans-serif; color:#7C8C92; }
+.fs-mo-need { margin-top:6px; font:800 14px 'Nunito',sans-serif; color:#5A4318; }
+.fs-mo-lanes { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
+.fs-mo-lane { background:#fff; border:2px solid #D2E1E5; border-radius:14px; padding:8px; }
+.fs-mo-name { font:900 15px 'Nunito',sans-serif; color:#0E1C42; margin-bottom:6px; }
+.fs-mo-ph { position:relative; border-radius:10px; overflow:hidden; aspect-ratio:1/1; background:#E6EEF0; }
+.fs-mo-ph img { width:100%; height:100%; object-fit:cover; display:block; } .fs-mo-ph img.in { animation: fsMoIn .5s ease-out; }
+@keyframes fsMoIn { from { opacity:.2; transform:scale(1.04); } to { opacity:1; transform:none; } }
+.fs-mo-stage { position:absolute; left:8px; top:8px; background:rgba(14,28,66,.85); color:#fff; font:900 13px 'Nunito',sans-serif; padding:3px 10px; border-radius:999px; }
+.fs-mo-like { margin-top:6px; font:900 14px 'Nunito',sans-serif; min-height:20px; } .fs-mo-like.yes { color:#1a6b35; } .fs-mo-like.no { color:#A0471B; }
+.fs-mo-note { font-size:14px; line-height:1.45; color:#3B4A50; min-height:40px; }
+.fs-mo-dots { display:flex; gap:6px; margin-top:6px; } .fs-mo-dots i { width:12px; height:12px; border-radius:50%; background:#D7E2E5; } .fs-mo-dots i.on { background:#2E9E5E; }
+.fs-wh-tabs, .fs-vn-tabs { display:flex; flex-wrap:wrap; gap:8px; margin:6px 0 10px; }
+.fs-wh-tabs .fs-in-chip.on, .fs-vn-tabs .fs-in-chip.on { background:#E3F1FA; border-color:#2B7BB9; }
+.fs-wh-board { display:grid; grid-template-columns: minmax(0,1.15fr) minmax(0,1fr); gap:14px; align-items:start; }
+.fs-wh-ring { position:relative; width:100%; aspect-ratio:1/1; max-width:440px; margin:0 auto; }
+.fs-wh-svg { position:absolute; inset:0; width:100%; height:100%; overflow:visible; }
+.fs-wh-arc { fill:none; stroke:#D2DDE0; stroke-width:1.6; stroke-dasharray:3 2.5; } .fs-wh-arc.on { stroke:#2E9E5E; stroke-dasharray:none; }
+.fs-wh-arc.last.on { stroke:#B9822A; }
+.fs-wh-spot { position:absolute; width:28%; aspect-ratio:1/1; transform:translate(-50%,-50%); border:3px dashed #9FB7BE; border-radius:16px; background:#F7FBFC; overflow:hidden; cursor:pointer; transition: border-color .2s, box-shadow .2s; }
+.fs-wh-spot.next { border-color: var(--fs-gold); box-shadow:0 0 0 4px rgba(242,183,5,.25); }
+.fs-wh-spot.over { background:#FFF9E8; }
+.fs-wh-spot.filled { border-style:solid; border-color:#2E9E5E; cursor:default; }
+.fs-wh-spot img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
+.fs-wh-spot.pop { animation: fsPop .45s; }
+.fs-wh-num { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); font:900 22px 'Nunito',sans-serif; color:#9FB7BE; }
+.fs-wh-spot.filled .fs-wh-num { display:none; }
+.fs-wh-t { position:absolute; left:0; right:0; bottom:0; background:rgba(14,28,66,.78); color:#fff; font:900 11px/1.2 'Nunito',sans-serif; text-align:center; padding:3px 2px 6px; }
+.fs-wh-mid { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:34%; text-align:center; font:900 14px/1.25 'Nunito',sans-serif; color:#0E1C42; }
+.fs-wh-kind { display:block; margin-top:4px; font-size:12px; color:#1a6b35; }
+.fs-wh-tray { display:flex; flex-wrap:wrap; gap:8px; }
+.fs-wh-card { width:110px; display:flex; flex-direction:column; align-items:center; gap:3px; padding:5px; text-align:center; touch-action:none; cursor:grab; }
+.fs-wh-card img { width:100%; aspect-ratio:1/1; object-fit:cover; border-radius:7px; pointer-events:none; } .fs-wh-card span { font-size:13px; }
+.fs-wh-card.placed { display:none; }
+.fs-wh-stamp { margin-top:12px; }
+.fs-vn-heads { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:8px; }
+.fs-vn-who { display:flex; align-items:center; gap:10px; font:900 15px 'Nunito',sans-serif; color:#0E1C42; }
+.fs-vn-who img { width:64px; height:64px; object-fit:cover; border-radius:50%; border:3px solid #fff; box-shadow:0 1px 5px rgba(0,0,0,.2); }
+.fs-vn-who:last-child { justify-content:flex-end; flex-direction:row-reverse; }
+.fs-vn-zones { display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px; margin-bottom:10px; }
+.fs-vn-z { border:2.5px dashed #9FB7BE; border-radius:14px; background:#F7FBFC; padding:8px; min-height:120px; cursor:pointer; transition: border-color .2s, background .2s; }
+.fs-vn-z.both { background:#F1F9F3; border-color:#8CC8A2; }
+.fs-vn-z.over { border-color: var(--fs-gold); background:#FFF9E8; }
+.fs-vn-zt { font:900 13px 'Nunito',sans-serif; color:#3B4A50; text-align:center; margin-bottom:6px; }
+.fs-vn-pile { display:flex; flex-direction:column; gap:5px; }
+.fs-vn-chip { background:#fff; border:1.5px solid #2E9E5E; border-radius:8px; padding:5px 8px; font:800 13px/1.3 'Nunito',sans-serif; color:#1a4f2e; }
+.fs-vn-chip.pop { animation: fsPop .4s; }
+.fs-vn-tray { display:flex; flex-wrap:wrap; gap:8px; } .fs-vn-card { flex:1 1 220px; touch-action:none; cursor:grab; line-height:1.35; }
+.fs-dn-parts, .fs-dn-spots { display:flex; flex-wrap:wrap; gap:8px; margin:6px 0; }
+.fs-dn-parts .fs-in-chip.on, .fs-dn-spots .fs-in-chip.on { background:#E3F1FA; border-color:#2B7BB9; }
+.fs-dn-pond { display:flex; flex-wrap:wrap; gap:12px; align-items:center; margin:8px 0; }
+.fs-dn-water { position:relative; flex:1 1 260px; height:110px; border-radius:14px; background:linear-gradient(180deg,#9BC7C2 0%,#5F9C8E 60%,#5B4A33 100%); overflow:hidden; }
+.fs-dn-water[data-k="reeds"] { background:linear-gradient(180deg,#A8CDB0 0%,#5F9C7A 60%,#4F4A30 100%); }
+.fs-dn-water[data-k="mud"] { background:linear-gradient(180deg,#8FB5AE 0%,#6C7E64 45%,#4B3A26 100%); }
+.fs-dn-net { position:absolute; left:8%; top:30%; font-size:40px; transition:none; }
+.fs-dn-water.sweep .fs-dn-net { animation: fsDnSweep 1.1s ease-in-out; }
+@keyframes fsDnSweep { 0% { left:8%; top:30%; } 50% { left:70%; top:55%; } 100% { left:8%; top:30%; } }
+.fs-dn-where { position:absolute; right:10px; bottom:8px; left:30%; text-align:right; color:#fff; font:900 14px 'Nunito',sans-serif; text-shadow:0 1px 3px rgba(0,0,0,.6); }
+.fs-dn-tray { display:flex; flex-wrap:wrap; gap:10px; background:#fff; border:3px solid #E3E8EA; border-radius:10px; padding:10px; min-height:80px; }
+.fs-dn-crit { width:110px; background:#F7FBFC; border:2px solid #C9D6DA; border-radius:10px; padding:5px; cursor:pointer; font:900 13px 'Nunito',sans-serif; color:#0E1C42; display:flex; flex-direction:column; gap:3px; align-items:center; }
+.fs-dn-crit img { width:100%; aspect-ratio:1/1; object-fit:cover; border-radius:7px; } .fs-dn-crit.seen { border-color:#2E9E5E; background:#EEF8F0; }
+.fs-dn-stage { display:inline-block; margin-left:6px; background:#E3F1FA; color:#1B4A6F; border-radius:999px; padding:1px 8px; font-size:12px; }
+@media (max-width: 760px) {
+  .fs-case-jars .fs-logs { grid-template-columns:1fr; } .fs-case-jars .fs-log { transform:none !important; }
+  .fs-mo-lanes { grid-template-columns:1fr; }
+  .fs-wh-board { grid-template-columns:1fr; }
+  .fs-vn-zones { grid-template-columns:1fr; } .fs-vn-heads { grid-template-columns:1fr 1fr; } .fs-vn-who img { width:48px; height:48px; }
+  .fs-nu-now .fs-nu-card, .fs-nu-slot { width:118px; } .fs-nu-q { line-height:100px; }
+}
+@media (prefers-reduced-motion: reduce) { .fs-nu-card.pop, .fs-wh-spot.pop, .fs-vn-chip.pop, .fs-mo-ph img.in, .fs-dn-water.sweep .fs-dn-net { animation:none; } }
